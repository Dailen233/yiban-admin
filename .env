# port 端口号：管理端固定使用 5175，避免与用户端 5174 及其他项目冲突
VITE_PORT = 5175

# open 运行 npm run dev 时是否自动打开浏览器（自动 EXEC 环境保持关闭）
VITE_OPEN = false

# public path 配置线上环境路径（打包）
VITE_PUBLIC_PATH = /

# 译伴后端地址。运行时默认 http://localhost:8001。
# VITE_* 会出现在浏览器产物中，不能保存翻译服务密钥、会话签名密钥等服务端秘密。
VITE_API_BASE_URL = http://localhost:8001
