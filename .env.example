# 环境配置示例文件
# 复制此文件为 .env.development 或 .env.production 并修改相应配置

# 项目基础配置
VITE_PORT = 3000
VITE_OPEN = true
VITE_PUBLIC_PATH = ./

# API 配置
VITE_API_URL = http://api.experiment.ncepu.edu.cn/api_1

# 百度地图 API 配置（如需要地图功能请取消注释并填入有效密钥）
# VITE_BAIDU_MAP_AK = your_baidu_map_api_key

# 百度统计配置（如需要统计功能请取消注释并填入有效密钥）
# VITE_BAIDU_ANALYTICS_ID = your_baidu_analytics_id

# 是否启用第三方服务
VITE_ENABLE_BAIDU_MAP = false
VITE_ENABLE_BAIDU_ANALYTICS = false
